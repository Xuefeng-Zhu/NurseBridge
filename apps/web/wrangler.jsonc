{
  "name": "nursebridge-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "REALTIME_URL": "ws://localhost:8788",
    "PROVIDER_MODE": "mock",
    "ALLOW_TEST_DIAGNOSTICS": "true",
    "MAX_ACTIVE_CALLS_PER_WORKSPACE": "2",
    "MAX_LIVE_CONCURRENCY": "4",
    "DAILY_AUDIO_MINUTES": "120",
    "ALLOW_LOCAL_SANDBOX_ENROLLMENT": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nursebridge-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EXPORTS",
      "bucket_name": "nursebridge-exports-local"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_SESSIONS",
        "class_name": "CallSession",
        "script_name": "nursebridge-realtime"
      }
    ]
  },
  "env": {
    "staging": {
      "name": "nursebridge-web-staging",
      "vars": {
        "APP_ORIGIN": "https://nursebridge-web-staging.pullthread-commerce-worker.workers.dev",
        "REALTIME_URL": "wss://nursebridge-realtime-staging.pullthread-commerce-worker.workers.dev",
        "PROVIDER_MODE": "live",
        "ALLOW_TEST_DIAGNOSTICS": "false",
        "MAX_ACTIVE_CALLS_PER_WORKSPACE": "2",
        "MAX_LIVE_CONCURRENCY": "4",
        "DAILY_AUDIO_MINUTES": "120",
        "FICTIONAL_LIVE_TEST": "false",
        "ALLOW_LOCAL_SANDBOX_ENROLLMENT": "false",
        "PUBLIC_WORKSPACE_ACCESS": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nursebridge-staging",
          "database_id": "d7c0b657-f87e-4b62-9949-fbafb85ff08c",
          "migrations_dir": "../../packages/database/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CALL_SESSIONS",
            "class_name": "CallSession",
            "script_name": "nursebridge-realtime-staging"
          }
        ]
      },
      "services": [
        {
          "binding": "REALTIME",
          "service": "nursebridge-realtime-staging"
        }
      ],
      "account_id": "62694a02d05e9f529bba1664135adc2f",
      "workers_dev": true,
      "preview_urls": false,
      "r2_buckets": []
    },
    "production": {
      "name": "nursebridge-web-production",
      "vars": {
        "APP_ORIGIN": "https://REPLACE-PRODUCTION-WEB.workers.dev",
        "REALTIME_URL": "wss://REPLACE-PRODUCTION-REALTIME.workers.dev",
        "PROVIDER_MODE": "live",
        "ALLOW_TEST_DIAGNOSTICS": "false",
        "MAX_ACTIVE_CALLS_PER_WORKSPACE": "2",
        "MAX_LIVE_CONCURRENCY": "4",
        "DAILY_AUDIO_MINUTES": "120",
        "FICTIONAL_LIVE_TEST": "false",
        "ALLOW_LOCAL_SANDBOX_ENROLLMENT": "false",
        "ACCESS_ISSUER": "https://REPLACE-ACCESS-TEAM.cloudflareaccess.com",
        "ACCESS_AUDIENCE": "REPLACE_ACCESS_APPLICATION_AUDIENCE"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nursebridge-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "../../packages/database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EXPORTS",
          "bucket_name": "nursebridge-exports-production"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CALL_SESSIONS",
            "class_name": "CallSession",
            "script_name": "nursebridge-realtime-production"
          }
        ]
      },
      "services": [
        {
          "binding": "REALTIME",
          "service": "nursebridge-realtime-production"
        }
      ]
    }
  },
  "services": [
    {
      "binding": "REALTIME",
      "service": "nursebridge-realtime"
    }
  ]
}
