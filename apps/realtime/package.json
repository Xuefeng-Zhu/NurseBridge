{
  "name": "@nursebridge/realtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788 --inspector-port 9231 --persist-to ../../.local/state",
    "typecheck": "tsc --noEmit",
    "bindings": "wrangler types worker-configuration.d.ts",
    "typegen": "wrangler types worker-configuration.d.ts",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@nursebridge/contracts": "workspace:*",
    "@nursebridge/intake-policy": "workspace:*",
    "@nursebridge/database": "workspace:*",
    "@nursebridge/audio-client": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@cloudflare/vitest-plugin": "1.1.13",
    "typescript": "5.9.3",
    "vitest": "4.1.4",
    "wrangler": "4.135.0"
  }
}
