{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nursebridge-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_SESSIONS",
        "class_name": "CallSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CallSession"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nursebridge-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EXPORTS",
      "bucket_name": "nursebridge-exports-local"
    }
  ],
  "vars": {
    "PROVIDER_MODE": "mock",
    "ALLOWED_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787,http://localhost:3000,http://127.0.0.1:3000",
    "MAX_CALL_SECONDS": "600",
    "RETENTION_SECONDS": "604800",
    "EXTRACTION_MODEL": "nvidia/Nemotron-3_5-Lightning",
    "VOICE_AGENT_ID": "",
    "VOICE_AGENT_VERSION": "",
    "VOICE_AGENT_COMPATIBILITY_VERIFIED": "false",
    "PHONE_INBOUND_ENABLED": "false",
    "TWILIO_ACCOUNT_SID": "",
    "TWILIO_PUBLIC_ORIGIN": "",
    "TWILIO_INBOUND_ROUTES": "{}",
    "PHONE_MAX_CONCURRENT": "2",
    "PHONE_DAILY_MINUTES": "60",
    "MAX_ACTIVE_CALLS_PER_WORKSPACE": "2",
    "MAX_LIVE_CONCURRENCY": "4",
    "DAILY_AUDIO_MINUTES": "120"
  },
  "observability": {
    "enabled": false
  },
  "env": {
    "staging": {
      "name": "nursebridge-realtime-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "CALL_SESSIONS",
            "class_name": "CallSession"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nursebridge-staging",
          "database_id": "d7c0b657-f87e-4b62-9949-fbafb85ff08c",
          "migrations_dir": "../../packages/database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EXPORTS",
          "bucket_name": "nursebridge-exports-staging"
        }
      ],
      "vars": {
        "PROVIDER_MODE": "live",
        "ALLOWED_ORIGINS": "https://nursebridge-web-staging.pullthread-commerce-worker.workers.dev",
        "MAX_CALL_SECONDS": "600",
        "RETENTION_SECONDS": "604800",
        "EXTRACTION_MODEL": "nvidia/Nemotron-3_5-Lightning",
        "VOICE_AGENT_ID": "",
        "VOICE_AGENT_VERSION": "",
        "VOICE_AGENT_COMPATIBILITY_VERIFIED": "false",
        "PHONE_INBOUND_ENABLED": "false",
        "TWILIO_ACCOUNT_SID": "",
        "TWILIO_PUBLIC_ORIGIN": "",
        "TWILIO_INBOUND_ROUTES": "{}",
        "PHONE_MAX_CONCURRENT": "2",
        "PHONE_DAILY_MINUTES": "60",
        "MAX_ACTIVE_CALLS_PER_WORKSPACE": "2",
        "MAX_LIVE_CONCURRENCY": "4",
        "DAILY_AUDIO_MINUTES": "120",
        "ALLOW_TEST_DIAGNOSTICS": "false",
        "FICTIONAL_LIVE_TEST": "false"
      },
      "account_id": "62694a02d05e9f529bba1664135adc2f",
      "workers_dev": true,
      "preview_urls": false
    },
    "production": {
      "name": "nursebridge-realtime-production",
      "durable_objects": {
        "bindings": [
          {
            "name": "CALL_SESSIONS",
            "class_name": "CallSession"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nursebridge-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "../../packages/database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EXPORTS",
          "bucket_name": "nursebridge-exports-production"
        }
      ],
      "vars": {
        "PROVIDER_MODE": "live",
        "ALLOWED_ORIGINS": "https://REPLACE-PRODUCTION-WEB.workers.dev",
        "MAX_CALL_SECONDS": "600",
        "RETENTION_SECONDS": "604800",
        "EXTRACTION_MODEL": "nvidia/Nemotron-3_5-Lightning",
        "VOICE_AGENT_ID": "",
        "VOICE_AGENT_VERSION": "",
        "VOICE_AGENT_COMPATIBILITY_VERIFIED": "false",
        "PHONE_INBOUND_ENABLED": "false",
        "TWILIO_ACCOUNT_SID": "",
        "TWILIO_PUBLIC_ORIGIN": "",
        "TWILIO_INBOUND_ROUTES": "{}",
        "PHONE_MAX_CONCURRENT": "2",
        "PHONE_DAILY_MINUTES": "60",
        "MAX_ACTIVE_CALLS_PER_WORKSPACE": "2",
        "MAX_LIVE_CONCURRENCY": "4",
        "DAILY_AUDIO_MINUTES": "120",
        "ALLOW_TEST_DIAGNOSTICS": "false",
        "FICTIONAL_LIVE_TEST": "false"
      }
    }
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
