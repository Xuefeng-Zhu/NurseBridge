{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nursebridge-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_SESSIONS",
        "class_name": "CallSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CallSession"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nursebridge-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EXPORTS",
      "bucket_name": "nursebridge-exports-local"
    }
  ],
  "vars": {
    "PROVIDER_MODE": "mock",
    "ALLOWED_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787,http://localhost:3000,http://127.0.0.1:3000",
    "MAX_CALL_SECONDS": "600",
    "RETENTION_SECONDS": "604800",
    "EXTRACTION_MODEL": "nvidia/Nemotron-3_5-Lightning",
    "VOICE_AGENT_ID": "",
    "VOICE_AGENT_VERSION": "",
    "VOICE_AGENT_COMPATIBILITY_VERIFIED": "false"
  },
  "observability": {
    "enabled": false
  },
  "env": {
    "staging": {
      "name": "nursebridge-realtime-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "CALL_SESSIONS",
            "class_name": "CallSession"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nursebridge-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "../../packages/database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EXPORTS",
          "bucket_name": "nursebridge-exports-staging"
        }
      ],
      "vars": {
        "PROVIDER_MODE": "live",
        "ALLOWED_ORIGINS": "https://nursebridge-web-staging.YOUR_SUBDOMAIN.workers.dev",
        "MAX_CALL_SECONDS": "600",
        "RETENTION_SECONDS": "604800",
        "EXTRACTION_MODEL": "nvidia/Nemotron-3_5-Lightning",
        "VOICE_AGENT_ID": "",
        "VOICE_AGENT_VERSION": "",
        "VOICE_AGENT_COMPATIBILITY_VERIFIED": "false"
      }
    }
  }
}
