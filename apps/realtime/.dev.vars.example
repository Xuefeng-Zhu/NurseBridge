# Explicit mock mode. A fictional-only local live test can set FICTIONAL_LIVE_TEST=true
# with PROVIDER_MODE=live on both Workers and loopback-only realtime ALLOWED_ORIGINS.
PROVIDER_MODE=mock
# assemblyai uses the managed conversational model and Qwen through its LLM Gateway.
# nebius preserves the original custom model for both conversation and extraction.
LLM_PROVIDER=nebius
ASSEMBLYAI_API_KEY=
NEBIUS_API_KEY=
# Optional extraction override; defaults to Qwen for assemblyai or Nemotron for nebius.
# EXTRACTION_MODEL=nvidia/Nemotron-3_5-Lightning
VOICE_AGENT_ID=
VOICE_AGENT_VERSION=
VOICE_AGENT_COMPATIBILITY_VERIFIED=false
FICTIONAL_LIVE_TEST=false
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:3000,http://127.0.0.1:3000

# Optional real inbound phone transport. Set secrets through Wrangler in staging.
# Route only to an intentionally selected active workspace; never use real patient data.
PHONE_INBOUND_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_ORIGIN=
TWILIO_INBOUND_ROUTES={}
PHONE_MAX_CONCURRENT=2
PHONE_DAILY_MINUTES=60
